{
  "folders": [
    { "path": "." }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Собрать открытый C++",
        "type": "process",
        "command": "C:/msys64/ucrt64/bin/g++.exe",
        "args": ["-std=c++17", "${fileBasename}", "-o", "${fileBasenameNoExtension}.exe"],
        "options": {
          "cwd": "${fileDirname}",
          "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
        },
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "Собрать и запустить C++",
        "type": "process",
        "dependsOn": "Собрать открытый C++",
        "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
        "options": {
          "cwd": "${fileDirname}",
          "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
        },
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "focus": true },
        "problemMatcher": []
      }
    ]
  }
}
